<!--
  迁移自 mytool/zsh/wsw-zshrc（原 wsw-zshrc）—— 个人 shell 别名/函数集合。

  priority=20：在 shell/oh-my-zsh(10) 之后加载，这样主题/补全先就位。
  oh-my-zsh 不再由这里 source —— 它有自己的 wtool 块（见 shell/oh-my-zsh）。

  env.zsh / env.bash 内容等价（别名、cw、pdd/pss、WSL 那几个小工具），
  分别由 ~/.zshrc 和 ~/.bashrc 的 wtool 块 source。
  路径 = 项目身份（ADR-0037）。2026-10-13 由 `shell/zsh` 改名成 **`shell/shell-rc`**
  （ADR-0045 §7.1）：里面本来就不只是 zsh（还有 bash 那一份），而且 `shell/zsh`
  这个名字要让给第 ⑦ 块新增的 zsh **源码**项目。GitHub 同名改
  `wtool-zsh` → `wtool-shell-rc`。
-->
<wtool schema="1" priority="20">

  <zshrc  src="env.zsh"/>
  <bashrc src="env.bash"/>

</wtool>
